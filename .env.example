# Porta local do servidor
PORT=3000

# URL pública pela qual os celulares acessam o app (HTTPS em produção / túnel).
# Precisa bater exatamente com o Redirect URI cadastrado no app do Spotify:
#   <BASE_URL>/auth/spotify/callback
BASE_URL=http://127.0.0.1:3000

# Spotify: só o Client ID, criado UMA vez pelo dono do servidor
# (https://developer.spotify.com/dashboard -> Create app -> Web API).
# O login usa PKCE: ninguém precisa de Client Secret. Também dá para deixar vazio e
# colar o Client ID na tela inicial do app, aberto em http://127.0.0.1:3000 no próprio
# computador do servidor (fica salvo em DATA_DIR/config.json).
SPOTIFY_CLIENT_ID=

# Opcional. Se existir, é usado SÓ para buscar no catálogo quando ninguém da sala
# entrou com o Spotify (Client Credentials). Pode deixar vazio.
SPOTIFY_CLIENT_SECRET=

# https://console.cloud.google.com -> APIs & Services -> YouTube Data API v3 -> Credentials -> API key
# Opcional. Sem chave, a busca usa o próprio site do YouTube (sem cota, não oficial).
YOUTUBE_API_KEY=

# Pasta onde ficam config.json e os tokens do Spotify (padrão: ./data)
# DATA_DIR=./data
