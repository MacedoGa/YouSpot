# Porta local do servidor
PORT=3000

# URL pública pela qual os celulares acessam o app (HTTPS em produção / túnel).
# Precisa bater exatamente com o Redirect URI cadastrado no Spotify:
#   <BASE_URL>/auth/spotify/callback
BASE_URL=http://127.0.0.1:3000

# https://developer.spotify.com/dashboard -> Create app (Web API)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# https://console.cloud.google.com -> APIs & Services -> YouTube Data API v3 -> Credentials -> API key
YOUTUBE_API_KEY=
